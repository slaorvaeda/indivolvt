# Indivolt Appliances Apache Configuration for Next.js Static Export

Options -Indexes +FollowSymLinks
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect space-encoded category URLs (e.g. /category/water%20pump/) to hyphenated (/category/water-pump/)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s+/category/([^\s/]+)%20([^\s/]+)/? [NC]
  RewriteRule ^ https://%{HTTP_HOST}/category/%1-%2/ [R=301,L]

  # Serve existing file or directory directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If request matches a directory with an index.html, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ /$1/index.html [L]

  # If request matches a direct .html file, serve it
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)/?$ /$1.html [L]

  # Fallback to 404.html for any unhandled route
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ 404.html [L]
</IfModule>

# Custom Error Pages (prevents shared hosting parking script injections)
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html
ErrorDocument 500 /404.html
